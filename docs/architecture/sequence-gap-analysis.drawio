<mxfile host="draw.io">
  <diagram name="Sequence – Gap Analysis" id="seq-gap">
    <mxGraphModel dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t1" value="&lt;b&gt;Sequence Diagram: Gap Analysis &amp; Remediation Flow (AIcomplainec)&lt;/b&gt;" style="text;html=1;align=center;fontSize=16;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="150" y="10" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Headers -->
        <mxCell id="h1" value="&lt;b&gt;Compliance&lt;br&gt;Officer&lt;/b&gt;" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="50" width="90" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="&lt;b&gt;AIcomplainec&lt;br&gt;UI&lt;/b&gt;" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="210" y="50" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="&lt;b&gt;Assessment&lt;br&gt;Engine&lt;/b&gt;" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="50" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="h4" value="&lt;b&gt;Gap&lt;br&gt;Detector&lt;/b&gt;" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="50" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="h5" value="&lt;b&gt;localStorage&lt;/b&gt;" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="50" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="ll1" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="75" y="100" as="sourcePoint"/><mxPoint x="75" y="740" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll2" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="100" as="sourcePoint"/><mxPoint x="260" y="740" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll3" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="100" as="sourcePoint"/><mxPoint x="470" y="740" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll4" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="100" as="sourcePoint"/><mxPoint x="680" y="740" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll5" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="100" as="sourcePoint"/><mxPoint x="900" y="740" as="targetPoint"/></mxGeometry></mxCell>

        <!-- Messages -->
        <mxCell id="m1" value="1. Navigate to Assessments page" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="80" y="130" as="sourcePoint"/><mxPoint x="255" y="130" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m2" value="2. Select framework (ISO 27001 / NCA ECC)" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="80" y="160" as="sourcePoint"/><mxPoint x="255" y="160" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m3" value="3. Select policies to assess" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="80" y="190" as="sourcePoint"/><mxPoint x="255" y="190" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m4" value="4. Click &quot;Run Assessment&quot;" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="80" y="220" as="sourcePoint"/><mxPoint x="255" y="220" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m5" value="5. runAssessment(framework, policies)" style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="265" y="250" as="sourcePoint"/><mxPoint x="465" y="250" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Loop: assess each control -->
        <mxCell id="loop1" value="loop [for each ECC control in framework]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=280;height=20;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;fontStyle=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="410" y="270" width="340" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="m6" value="6. Compare policy against control requirements" style="endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1;dashed=1;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="475" y="300" as="sourcePoint"/><mxPoint x="530" y="300" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m7" value="7. detectGaps(policy, control)" style="endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="475" y="330" as="sourcePoint"/><mxPoint x="675" y="330" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m8" value="8. {gaps: [], severity, recommendations}" style="endArrow=open;endFill=0;dashed=1;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="675" y="365" as="sourcePoint"/><mxPoint x="475" y="365" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Calculate score -->
        <mxCell id="m9" value="9. Calculate overall_score from all controls" style="endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1;dashed=1;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="475" y="430" as="sourcePoint"/><mxPoint x="530" y="430" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m10" value="10. {assessment: results, score, gaps_summary}" style="endArrow=open;endFill=0;dashed=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="465" y="460" as="sourcePoint"/><mxPoint x="265" y="460" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Save assessment -->
        <mxCell id="m11" value="11. Save assessment to localStorage" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="265" y="490" as="sourcePoint"/><mxPoint x="895" y="490" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m12" value="12. {ok}" style="endArrow=open;endFill=0;dashed=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="895" y="515" as="sourcePoint"/><mxPoint x="265" y="515" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Auto-create remediation tasks -->
        <mxCell id="m13" value="13. Auto-generate remediation tasks for each gap" style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="265" y="545" as="sourcePoint"/><mxPoint x="675" y="545" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m14" value="14. {tasks: [{title, priority, ai_guidance}]}" style="endArrow=open;endFill=0;dashed=1;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="675" y="575" as="sourcePoint"/><mxPoint x="265" y="575" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Save tasks -->
        <mxCell id="m15" value="15. Save remediation tasks" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="265" y="600" as="sourcePoint"/><mxPoint x="895" y="600" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Display results -->
        <mxCell id="m16" value="16. Display: score, gaps, remediation tasks" style="endArrow=open;endFill=0;dashed=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="255" y="650" as="sourcePoint"/><mxPoint x="80" y="650" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Log audit -->
        <mxCell id="m17" value="17. Log audit entry" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1;dashed=1;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="265" y="680" as="sourcePoint"/><mxPoint x="895" y="680" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Notes -->
        <mxCell id="n1" value="&lt;b&gt;Frameworks:&lt;/b&gt;&lt;br&gt;• ISO 27001:2022&lt;br&gt;• NCA ECC-2:2024&lt;br&gt;&lt;b&gt;Controls:&lt;/b&gt;&lt;br&gt;• ECC 2-2 (Password)&lt;br&gt;• ECC 1-5 (Risk Assessment)" style="shape=note;size=15;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="700" width="170" height="100" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>