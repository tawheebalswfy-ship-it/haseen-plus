<mxfile host="draw.io">
  <diagram name="Activity – Remediation Task Lifecycle" id="act-remed">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t1" value="&lt;b&gt;Activity Diagram: Remediation Task Lifecycle&lt;/b&gt;" style="text;html=1;align=center;fontSize=16;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- Swimlanes -->
        <mxCell id="sw1" value="Compliance Officer" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="50" width="300" height="920" as="geometry"/>
        </mxCell>
        <mxCell id="sw2" value="IT / Security Team" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="50" width="300" height="920" as="geometry"/>
        </mxCell>
        <mxCell id="sw3" value="System" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;html=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="50" width="300" height="920" as="geometry"/>
        </mxCell>

        <!-- Start -->
        <mxCell id="start" value="" style="ellipse;html=1;shape=mxgraph.flowchart.start_2;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="165" y="100" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- Actions -->
        <mxCell id="a1" value="Review Gap Analysis&lt;br&gt;Report" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="160" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="a2" value="Identify Non-Compliant&lt;br&gt;Policy Areas" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="230" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="a3" value="Create Remediation&lt;br&gt;Task (title, desc,&lt;br&gt;priority, deadline)" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="300" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="a4" value="Assign Task to&lt;br&gt;Team Member" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="380" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="a5" value="Set Task Status&lt;br&gt;→ open" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="380" width="130" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="a6" value="Receive Task&lt;br&gt;Notification" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="450" width="130" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="a7" value="Begin Implementation&lt;br&gt;(update policies,&lt;br&gt;controls, config)" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="520" width="150" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="a7b" value="Update Status&lt;br&gt;→ in_progress" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="530" width="130" height="40" as="geometry"/>
        </mxCell>

        <!-- Decision: Can fix? -->
        <mxCell id="d1" value="Fix&lt;br&gt;possible?" style="rhombus;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="445" y="600" width="80" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="a8" value="Document changes&lt;br&gt;and evidence" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="700" width="150" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="a8b" value="Request Deferral&lt;br&gt;(add justification)" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="780" width="150" height="40" as="geometry"/>
        </mxCell>

        <!-- Decision: Approve deferral? -->
        <mxCell id="d2" value="Approve&lt;br&gt;deferral?" style="rhombus;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="770" width="80" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="a9" value="Mark Complete&lt;br&gt;→ completed" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="700" width="130" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="a10" value="Mark Deferred&lt;br&gt;→ deferred" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="780" width="130" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="a11" value="Generate Updated&lt;br&gt;Compliance Report" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="860" width="140" height="40" as="geometry"/>
        </mxCell>

        <!-- End -->
        <mxCell id="end" value="" style="ellipse;html=1;shape=mxgraph.flowchart.terminate;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="775" y="930" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- Flow arrows -->
        <mxCell id="f1" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="start" target="a1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="a1" target="a2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="a2" target="a3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="a3" target="a4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="a4" target="a5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="a5" target="a6" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="470"/></Array></mxGeometry></mxCell>
        <mxCell id="f7" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="a6" target="a7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f7b" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="a7" target="a7b" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f8" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="a7" target="d1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f9" value="Yes" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;fontSize=9;" edge="1" source="d1" target="a8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f10" value="No" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;fontSize=9;" edge="1" source="d1" target="a8b" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="635"/><mxPoint x="400" y="800"/></Array></mxGeometry></mxCell>
        <mxCell id="f11" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="a8" target="a9" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f12" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="a8b" target="d2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f13" value="Yes" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;fontSize=9;" edge="1" source="d2" target="a10" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="830"/><mxPoint x="680" y="830"/><mxPoint x="680" y="800"/></Array></mxGeometry></mxCell>
        <mxCell id="f14" value="No → Rework" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;fontSize=9;" edge="1" source="d2" target="a7" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="805"/><mxPoint x="100" y="545"/><mxPoint x="410" y="545"/></Array></mxGeometry></mxCell>
        <mxCell id="f15" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="a9" target="a11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f15b" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="a10" target="a11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f16" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="a11" target="end" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
