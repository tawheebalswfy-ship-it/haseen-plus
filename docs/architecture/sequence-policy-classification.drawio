<mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="750" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="Sequence — Policy Upload &amp; Classification" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="250" y="10" width="600" height="35" as="geometry"/>
    </mxCell>

    <!-- Lifelines -->
    <mxCell id="ll_user" value="User" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;participant=umlActor;fillColor=#DAE8FC;strokeColor=#6C8EBF;size=40;" vertex="1" parent="1">
      <mxGeometry x="60" y="60" width="20" height="660" as="geometry"/>
    </mxCell>
    <mxCell id="ll_fe" value=":PoliciesPage" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FFF2CC;strokeColor=#D6B656;size=40;" vertex="1" parent="1">
      <mxGeometry x="200" y="60" width="120" height="660" as="geometry"/>
    </mxCell>
    <mxCell id="ll_ext" value=":TextExtractor" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#D5E8D4;strokeColor=#82B366;size=40;" vertex="1" parent="1">
      <mxGeometry x="400" y="60" width="110" height="660" as="geometry"/>
    </mxCell>
    <mxCell id="ll_sb_s" value=":Supabase&#xa;Storage" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#E1D5E7;strokeColor=#9673A6;size=40;" vertex="1" parent="1">
      <mxGeometry x="580" y="60" width="100" height="660" as="geometry"/>
    </mxCell>
    <mxCell id="ll_store" value=":ComplianceStore" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FFE6CC;strokeColor=#D79B00;size=40;" vertex="1" parent="1">
      <mxGeometry x="750" y="60" width="120" height="660" as="geometry"/>
    </mxCell>
    <mxCell id="ll_api" value=":ML API&#xa;(Cloud Run)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#D5E8D4;strokeColor=#82B366;size=40;" vertex="1" parent="1">
      <mxGeometry x="940" y="60" width="110" height="660" as="geometry"/>
    </mxCell>
    <mxCell id="ll_mbert" value=":mBERT Model" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FFE6CC;strokeColor=#D79B00;size=40;" vertex="1" parent="1">
      <mxGeometry x="1120" y="60" width="110" height="660" as="geometry"/>
    </mxCell>

    <!-- Messages -->
    <!-- 1. Upload file -->
    <mxCell id="m1" value="1. selectFile(PDF/DOCX/TXT)" style="html=1;verticalAlign=bottom;endArrow=block;entryX=0;entryY=0;exitX=1;exitY=0;fontSize=9;" edge="1" parent="1">
      <mxGeometry x="70" y="130" width="190" height="20" relative="1" as="geometry">
        <mxPoint x="70" y="130" as="sourcePoint"/>
        <mxPoint x="260" y="130" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <!-- 2. Extract text -->
    <mxCell id="m2" value="2. extractTextFromFile(file)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="260" y="170" as="sourcePoint"/>
        <mxPoint x="455" y="170" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="m2r" value="extracted text" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="455" y="210" as="sourcePoint"/>
        <mxPoint x="260" y="210" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <!-- 3. Upload file to storage -->
    <mxCell id="m3" value="3. upload(file) → policy-files/{uid}/{uuid}.ext" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="260" y="250" as="sourcePoint"/>
        <mxPoint x="630" y="250" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="m3r" value="publicUrl" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="630" y="280" as="sourcePoint"/>
        <mxPoint x="260" y="280" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <!-- 4. Save policy (analyzing) -->
    <mxCell id="m4" value="4. addPolicy({title, status: &quot;analyzing&quot;, file_url})" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="260" y="320" as="sourcePoint"/>
        <mxPoint x="810" y="320" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="m4r" value="policyId" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="810" y="350" as="sourcePoint"/>
        <mxPoint x="260" y="350" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <!-- 5. Call ML API -->
    <mxCell id="m5" value="5. POST /analyze {text, threshold: 0.6}" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;fontStyle=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="260" y="390" as="sourcePoint"/>
        <mxPoint x="995" y="390" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <!-- 5a. Chunk + Detect domains -->
    <mxCell id="m5a" value="5a. detect domains + chunk text" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=8;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="995" y="420" as="sourcePoint"/>
        <mxPoint x="995" y="440" as="targetPoint"/>
        <Array as="points">
          <mxPoint x="1030" y="420"/>
          <mxPoint x="1030" y="440"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- 5b. Forward each chunk -->
    <mxCell id="m5b" value="5b. forward(input_ids) per chunk → 16 logits" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="995" y="470" as="sourcePoint"/>
        <mxPoint x="1175" y="470" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="m5br" value="sigmoid(logits) → probabilities" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1175" y="500" as="sourcePoint"/>
        <mxPoint x="995" y="500" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <!-- 5c. Max-pool aggregate -->
    <mxCell id="m5c" value="5c. max-pool + severity scoring" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=8;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="995" y="530" as="sourcePoint"/>
        <mxPoint x="995" y="550" as="targetPoint"/>
        <Array as="points">
          <mxPoint x="1030" y="530"/>
          <mxPoint x="1030" y="550"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- 5d. Return AnalyzeResponse -->
    <mxCell id="m5r" value="AnalyzeResponse {gaps, scores, domains}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontStyle=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="995" y="580" as="sourcePoint"/>
        <mxPoint x="260" y="580" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <!-- 6. Update policy with results -->
    <mxCell id="m6" value="6. updatePolicy(id, {status: &quot;analyzed&quot;, analysis_result, compliance_score})" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="260" y="620" as="sourcePoint"/>
        <mxPoint x="810" y="620" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <!-- 7. Show results to user -->
    <mxCell id="m7" value="7. display analysis results" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="260" y="660" as="sourcePoint"/>
        <mxPoint x="70" y="660" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

  </root>
</mxGraphModel>