        <mxCell id="p10" value="&lt;b&gt;10.0&lt;/b&gt;&lt;br&gt;Generate Training&lt;br&gt;Dataset" style="ellipse;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="780" width="140" height="80" as="geometry"/>
        </mxCell>

        <!-- ===== DATA STORES ===== -->
        <mxCell id="ds1" value="D1 &amp;nbsp; Users / Profiles" style="shape=partialRectangle;html=1;top=0;bottom=0;right=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1">
