        <!-- Legend -->
        <mxCell id="leg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style='color:#dae8fc'&gt;██&lt;/span&gt; External Entity&lt;br&gt;&lt;span style='color:#d5e8d4'&gt;██&lt;/span&gt; Process&lt;br&gt;&lt;span style='color:#e1d5e7'&gt;██&lt;/span&gt; Data Store&lt;br&gt;→ Data Flow" style="text;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666;rounded=1;fontSize=10;spacingLeft=8;shadow=1;" vertex="1" parent="1">
