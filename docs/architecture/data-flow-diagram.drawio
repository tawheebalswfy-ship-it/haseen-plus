        <mxCell id="ds8" value="D8 &amp;nbsp; ML Model Artifacts" style="shape=partialRectangle;html=1;top=0;bottom=0;right=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="140" width="200" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="ds9" value="D9 &amp;nbsp; Training Dataset" style="shape=partialRectangle;html=1;top=0;bottom=0;right=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="890" width="200" height="35" as="geometry"/>
        </mxCell>

        <!-- ===== DATA FLOWS ===== -->
        <!-- Analyst → P1 -->
        <mxCell id="df1" value="email + OTP" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="e1" target="p1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- P1 → Neon Auth -->
        <mxCell id="df2" value="OTP request" style="endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="p1" target="e3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Neon Auth → P1 -->
        <mxCell id="df3" value="session token" style="endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="e3" target="p1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="130"/><mxPoint x="500" y="130"/></Array></mxGeometry></mxCell>
        <!-- P1 → DS1 -->
        <mxCell id="df4" value="user profile" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="p1" target="ds1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Analyst → P2 -->
        <mxCell id="df5" value="policy text + category" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="e1" target="p2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- P2 → P3 -->
        <mxCell id="df6" value="policy text" style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="p2" target="p3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- DS8 → P3 -->
        <mxCell id="df6b" value="model weights" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="ds8" target="p3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- P3 → P2 -->
        <mxCell id="df7" value="label + confidence + probs" style="endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="p3" target="p2" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="290"/></Array></mxGeometry></mxCell>
        <!-- P2 → P4 -->
