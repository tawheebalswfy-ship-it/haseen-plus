        <!-- P8 → DS6 -->
        <mxCell id="df16" value="report content" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="p8" target="ds6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- P8 → Officer -->
        <mxCell id="df17" value="compliance report (PDF)" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="p8" target="e2" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="600"/><mxPoint x="250" y="500"/></Array></mxGeometry></mxCell>
        <!-- DS3 → P5 -->
