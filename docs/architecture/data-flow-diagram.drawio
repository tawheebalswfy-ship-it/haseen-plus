          <mxGeometry x="350" y="560" width="140" height="80" as="geometry"/>
        </mxCell>

        <!-- P9: Schedule Analysis -->
        <mxCell id="p9" value="&lt;b&gt;9.0&lt;/b&gt;&lt;br&gt;Schedule&lt;br&gt;Analysis" style="ellipse;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="720" width="140" height="80" as="geometry"/>
        </mxCell>

