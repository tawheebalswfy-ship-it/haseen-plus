<mxfile host="draw.io">
  <diagram name="Data Flow Diagram (DFD)" id="dfd">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t1" value="&lt;b&gt;PolicyShield – Data Flow Diagram (Level 1)&lt;/b&gt;" style="text;html=1;align=center;fontSize=18;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="400" height="35" as="geometry"/>
        </mxCell>

        <!-- ===== EXTERNAL ENTITIES ===== -->
        <mxCell id="e1" value="&lt;b&gt;Security Analyst&lt;/b&gt;" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;shadow=1;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;Compliance Officer&lt;/b&gt;" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="440" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;Neon Auth&lt;br&gt;(External)&lt;/b&gt;" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="80" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="&lt;b&gt;Google Gemini&lt;br&gt;(External)&lt;/b&gt;" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="800" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== PROCESSES (circles) ===== -->
        <!-- P1: Authenticate User -->
        <mxCell id="p1" value="&lt;b&gt;1.0&lt;/b&gt;&lt;br&gt;Authenticate&lt;br&gt;User" style="ellipse;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="70" width="140" height="80" as="geometry"/>
        </mxCell>

        <!-- P2: Classify Policy -->
        <mxCell id="p2" value="&lt;b&gt;2.0&lt;/b&gt;&lt;br&gt;Classify&lt;br&gt;Policy" style="ellipse;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;shadow=1;" vertex="1" parent="1">
