        <mxCell id="ds6" value="D6 &amp;nbsp; Reports" style="shape=partialRectangle;html=1;top=0;bottom=0;right=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="630" width="200" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="ds7" value="D7 &amp;nbsp; Schedules" style="shape=partialRectangle;html=1;top=0;bottom=0;right=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="700" width="200" height="35" as="geometry"/>
