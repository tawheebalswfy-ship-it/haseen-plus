        <!-- P4 → DS2 -->
        <mxCell id="df8" value="save result" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="p4" target="ds2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- P2 → Analyst -->
        <mxCell id="df9" value="classification results" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="p2" target="e1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="260"/><mxPoint x="250" y="160"/></Array></mxGeometry></mxCell>

        <!-- Officer → P5 -->
        <mxCell id="df10" value="framework + policies" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="e2" target="p5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- P5 → P6 -->
