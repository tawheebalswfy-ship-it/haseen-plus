        </mxCell>

        <!-- P3: ML Inference -->
        <mxCell id="p3" value="&lt;b&gt;3.0&lt;/b&gt;&lt;br&gt;ML Inference&lt;br&gt;(mBERT)" style="ellipse;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="220" width="140" height="80" as="geometry"/>
        </mxCell>

        <!-- P4: Manage History -->
        <mxCell id="p4" value="&lt;b&gt;4.0&lt;/b&gt;&lt;br&gt;Manage&lt;br&gt;History" style="ellipse;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="220" width="140" height="80" as="geometry"/>
        </mxCell>

        <!-- P5: Run Assessment -->
        <mxCell id="p5" value="&lt;b&gt;5.0&lt;/b&gt;&lt;br&gt;Run Compliance&lt;br&gt;Assessment" style="ellipse;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="400" width="140" height="80" as="geometry"/>
        </mxCell>

        <!-- P6: Detect Gaps -->
        <mxCell id="p6" value="&lt;b&gt;6.0&lt;/b&gt;&lt;br&gt;Detect Gaps&lt;br&gt;&amp; Score" style="ellipse;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="400" width="140" height="80" as="geometry"/>
        </mxCell>

