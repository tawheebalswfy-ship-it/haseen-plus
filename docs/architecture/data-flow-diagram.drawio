        <mxCell id="ds5" value="D5 &amp;nbsp; Remediation Tasks" style="shape=partialRectangle;html=1;top=0;bottom=0;right=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1">
