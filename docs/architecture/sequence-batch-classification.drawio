<mxfile host="draw.io">
  <diagram name="Sequence – Batch Classification" id="seq-batch">
    <mxGraphModel dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t1" value="&lt;b&gt;Sequence Diagram: Batch Policy Classification Flow&lt;/b&gt;" style="text;html=1;align=center;fontSize=16;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- Headers -->
        <mxCell id="h1" value="&lt;b&gt;User&lt;/b&gt;" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="&lt;b&gt;React App&lt;/b&gt;" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="210" y="50" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="&lt;b&gt;FastAPI&lt;/b&gt;" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="50" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="h4" value="&lt;b&gt;mBERT&lt;/b&gt;" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="50" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="h5" value="&lt;b&gt;Neon DB&lt;/b&gt;" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="50" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="ll1" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="90" as="sourcePoint"/><mxPoint x="80" y="740" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll2" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="90" as="sourcePoint"/><mxPoint x="260" y="740" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll3" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="90" as="sourcePoint"/><mxPoint x="480" y="740" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll4" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="90" as="sourcePoint"/><mxPoint x="690" y="740" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll5" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="90" as="sourcePoint"/><mxPoint x="900" y="740" as="targetPoint"/></mxGeometry></mxCell>

        <!-- Messages -->
        <mxCell id="m1" value="1. Upload/paste multiple policy texts" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="85" y="120" as="sourcePoint"/><mxPoint x="255" y="120" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m2" value="2. Validate: max 32 texts, each non-empty" style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1;dashed=1;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="265" y="150" as="sourcePoint"/><mxPoint x="320" y="150" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m3" value="3. POST /classify/batch {texts: [text1, text2, ...textN]}" style="endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="265" y="180" as="sourcePoint"/><mxPoint x="475" y="180" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Loop fragment -->
        <mxCell id="loop" value="loop [for each text in batch (max 32)]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=280;height=20;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;fontStyle=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="420" y="210" width="340" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="m4" value="4. Tokenize text[i] (512 max tokens)" style="endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="485" y="250" as="sourcePoint"/><mxPoint x="685" y="250" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m5" value="5. mBERT forward pass → softmax" style="endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=1;dashed=1;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="695" y="285" as="sourcePoint"/><mxPoint x="745" y="285" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m6" value="6. {label, confidence, probs}" style="endArrow=open;endFill=0;dashed=1;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="685" y="320" as="sourcePoint"/><mxPoint x="485" y="320" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m6b" value="7. Append result[i] to results array" style="endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1;dashed=1;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="485" y="360" as="sourcePoint"/><mxPoint x="540" y="360" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- End loop -->

        <mxCell id="m7" value="8. JSON {results: [{label, confidence, probs}, ...], total_time}" style="endArrow=open;endFill=0;dashed=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="475" y="420" as="sourcePoint"/><mxPoint x="265" y="440" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Loop: save each result -->
        <mxCell id="loop2" value="loop [for each result]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=160;height=20;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;fontStyle=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="200" y="470" width="770" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="m8" value="9. INSERT INTO classification_history (result[i])" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="265" y="510" as="sourcePoint"/><mxPoint x="895" y="510" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m9" value="10. {ok}" style="endArrow=open;endFill=0;dashed=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="895" y="540" as="sourcePoint"/><mxPoint x="265" y="555" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Display -->
        <mxCell id="m10" value="11. Render batch results table (all labels + confidence bars)" style="endArrow=open;endFill=0;dashed=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="255" y="620" as="sourcePoint"/><mxPoint x="85" y="640" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Notes -->
        <mxCell id="n1" value="&lt;b&gt;Batch Limits:&lt;/b&gt;&lt;br&gt;• Max 32 texts per batch&lt;br&gt;• ~400-800ms for 8 policies&lt;br&gt;• Results returned as array&lt;br&gt;• Each saved individually to DB" style="shape=note;size=15;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="620" width="210" height="90" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>