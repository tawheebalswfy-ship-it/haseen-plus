        <mxCell id="art5" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;&lt;b&gt;app.py&lt;/b&gt;&lt;br&gt;FastAPI + Uvicorn&lt;br&gt;Port 8080" style="shape=note;size=15;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="230" width="120" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="art6" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;&lt;b&gt;mBERT Model&lt;/b&gt;&lt;br&gt;model.safetensors&lt;br&gt;~681 MB" style="shape=note;size=15;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="310" width="120" height="70" as="geometry"/>
        </mxCell>

        <!-- Resource limits -->
        <mxCell id="res" value="&lt;b&gt;Resources:&lt;/b&gt;&lt;br&gt;CPU: 2 vCPU&lt;br&gt;RAM: 2 GB&lt;br&gt;Max instances: auto&lt;br&gt;Min instances: 0&lt;br&gt;Timeout: 300s" style="text;html=1;fillColor=none;strokeColor=none;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="685" y="230" width="100" height="100" as="geometry"/>
        </mxCell>

        <!-- GCS -->
        <mxCell id="node4" value="&lt;&lt;storage&gt;&gt;&lt;br&gt;&lt;b&gt;Cloud Storage&lt;/b&gt;&lt;br&gt;(GCS Bucket)" style="shape=cylinder3;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="130" width="170" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="art7" value="model.safetensors&lt;br&gt;tokenizer.json&lt;br&gt;config.json" style="text;html=1;fontSize=9;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="830" y="200" width="130" height="40" as="geometry"/>
        </mxCell>

        <!-- Cloud Run ↔ GCS -->
        <mxCell id="conn2" value="download&lt;br&gt;on startup" style="endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#FFF;dashed=1;" edge="1" source="node3" target="node4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== NEON CLOUD ===== -->
        <mxCell id="node5" value="&lt;&lt;cloud&gt;&gt;&lt;br&gt;&lt;b&gt;Neon Cloud&lt;/b&gt;" style="shape=mxgraph.sysml.package;html=1;overflow=fill;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="530" width="520" height="210" as="geometry"/>
        </mxCell>

        <!-- Neon Serverless Postgres -->
        <mxCell id="node5a" value="" style="shape=cylinder3;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="590" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="node5al" value="&lt;b&gt;Neon Serverless&lt;br&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;br&gt;• users table&lt;br&gt;• classification_history" style="text;html=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="545" y="610" width="170" height="80" as="geometry"/>
        </mxCell>

        <!-- Neon Auth -->
        <mxCell id="node5b" value="&lt;&lt;service&gt;&gt;&lt;br&gt;&lt;b&gt;Neon Auth&lt;/b&gt;&lt;br&gt;Email OTP Provider&lt;br&gt;@neondatabase/neon-js" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;shadow=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="790" y="600" width="190" height="80" as="geometry"/>
        </mxCell>

        <!-- ===== CONNECTIONS ===== -->
        <!-- Browser → Cloud Run (API) -->
        <mxCell id="conn3" value="HTTPS/REST&lt;br&gt;POST /classify" style="endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="node1" target="node3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Browser → Neon DB (SQL) -->
        <mxCell id="conn4" value="SQL over&lt;br&gt;WebSocket" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="node1" target="node5a" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="650"/></Array></mxGeometry></mxCell>

        <!-- Browser → Neon Auth -->
        <mxCell id="conn5" value="OTP Auth" style="endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="node1" target="node5b" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="640"/></Array></mxGeometry></mxCell>

        <!-- ===== DEVELOPER MACHINE ===== -->
        <mxCell id="node6" value="&lt;&lt;device&gt;&gt;&lt;br&gt;&lt;b&gt;Developer Machine&lt;/b&gt;&lt;br&gt;(Training &amp; Dataset Gen)" style="shape=mxgraph.sysml.package;html=1;overflow=fill;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="70" width="260" height="320" as="geometry"/>
