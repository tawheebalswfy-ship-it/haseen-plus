<mxfile host="draw.io">
  <diagram name="Deployment Diagram" id="deploy">
    <mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t1" value="&lt;b&gt;PolicyShield – Deployment Diagram (UML)&lt;/b&gt;" style="text;html=1;align=center;fontSize=18;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="400" height="35" as="geometry"/>
        </mxCell>

        <!-- ===== CLIENT DEVICE ===== -->
        <mxCell id="node1" value="&lt;&lt;device&gt;&gt;&lt;br&gt;&lt;b&gt;Client Device&lt;/b&gt;&lt;br&gt;(PC / Laptop / Mobile)" style="shape=mxgraph.sysml.package;html=1;overflow=fill;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="380" height="320" as="geometry"/>
        </mxCell>

        <!-- Browser -->
        <mxCell id="node1a" value="&lt;&lt;execution environment&gt;&gt;&lt;br&gt;&lt;b&gt;Web Browser&lt;/b&gt; (Chrome / Firefox)" style="shape=mxgraph.sysml.package;html=1;overflow=fill;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="340" height="240" as="geometry"/>
        </mxCell>

        <mxCell id="art1" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;&lt;b&gt;iso-security-app&lt;/b&gt;&lt;br&gt;React 19 + TS 5.9&lt;br&gt;Vite 7 SPA Bundle&lt;br&gt;(~2 MB gzipped)" style="shape=note;size=20;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="145" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="art2" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;&lt;b&gt;AIcomplainec&lt;/b&gt;&lt;br&gt;React + Vite SPA&lt;br&gt;Standalone (localStorage)&lt;br&gt;(~1.5 MB gzipped)" style="shape=note;size=20;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="170" width="145" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="art3" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;&lt;b&gt;localStorage&lt;/b&gt;&lt;br&gt;compliance_guard_* keys" style="shape=note;size=20;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="170" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== STATIC HOSTING ===== -->
        <mxCell id="node2" value="&lt;&lt;cloud&gt;&gt;&lt;br&gt;&lt;b&gt;Static Hosting&lt;/b&gt;&lt;br&gt;(Vercel / Netlify)" style="shape=cloud;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="440" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="art4" value="Static files:&lt;br&gt;index.html, JS, CSS, assets" style="text;html=1;fontSize=9;fontStyle=2;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="150" y="505" width="160" height="30" as="geometry"/>
        </mxCell>

        <!-- Browser ↔ Static Host -->
        <mxCell id="conn1" value="CDN / HTTPS" style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFF;" edge="1" source="node1" target="node2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== GOOGLE CLOUD ===== -->
        <mxCell id="gc" value="&lt;&lt;cloud&gt;&gt;&lt;br&gt;&lt;b&gt;Google Cloud Platform&lt;/b&gt;" style="shape=mxgraph.sysml.package;html=1;overflow=fill;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="70" width="520" height="420" as="geometry"/>
        </mxCell>

        <!-- Cloud Run -->
        <mxCell id="node3" value="&lt;&lt;execution environment&gt;&gt;&lt;br&gt;&lt;b&gt;Cloud Run&lt;/b&gt;&lt;br&gt;Region: me-central1 (Doha)" style="shape=mxgraph.sysml.package;html=1;overflow=fill;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="130" width="240" height="250" as="geometry"/>
        </mxCell>

        <!-- Docker -->
        <mxCell id="node3a" value="&lt;&lt;container&gt;&gt;&lt;br&gt;&lt;b&gt;Docker&lt;/b&gt;&lt;br&gt;Python 3.11-slim" style="shape=mxgraph.sysml.package;html=1;overflow=fill;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="535" y="185" width="210" height="175" as="geometry"/>
