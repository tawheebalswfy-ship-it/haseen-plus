        <mxCell id="art8" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;&lt;b&gt;generate_compliance_dataset.py&lt;/b&gt;&lt;br&gt;Python 3.11 + Gemini API" style="shape=note;size=15;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1095" y="130" width="230" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="art9" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;&lt;b&gt;model_building.ipynb&lt;/b&gt;&lt;br&gt;Jupyter Notebook&lt;br&gt;mBERT Fine-tuning" style="shape=note;size=15;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1095" y="200" width="230" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="art10" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;&lt;b&gt;dataset/&lt;/b&gt;&lt;br&gt;compliance_dataset.csv&lt;br&gt;compliance_dataset.json" style="shape=note;size=15;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1095" y="280" width="230" height="65" as="geometry"/>
        </mxCell>

        <!-- Dev → GCS (deploy model) -->
        <mxCell id="conn6" value="deploy model artifacts" style="endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=9;labelBackgroundColor=#FFF;" edge="1" source="node6" target="node4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Dev → Gemini API -->
        <mxCell id="gemini" value="&lt;&lt;external&gt;&gt;&lt;br&gt;&lt;b&gt;Gemini 2.0 Flash API&lt;/b&gt;" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1130" y="440" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="conn7" value="API calls" style="endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#FFF;" edge="1" source="node6" target="gemini" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Protocol labels -->
        <mxCell id="proto" value="&lt;b&gt;Protocols:&lt;/b&gt; HTTPS, WebSocket (wss://), gRPC (internal)" style="text;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666;rounded=1;spacingLeft=8;spacingRight=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="770" width="350" height="25" as="geometry"/>
