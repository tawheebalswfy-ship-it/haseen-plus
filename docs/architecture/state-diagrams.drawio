        </mxCell>

        <!-- Final States -->
        <mxCell id="s2_end1" value="" style="ellipse;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="833" y="440" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="s2_end1_ring" value="" style="ellipse;html=1;aspect=fixed;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="828" y="435" width="34" height="34" as="geometry"/>
        </mxCell>

        <!-- Transitions -->
        <mxCell id="t2_1" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="s2_init" target="s2_open" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t2_2" value="start work" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;fontSize=9;" edge="1" source="s2_open" target="s2_inprog" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t2_3" value="fix applied" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;fontSize=9;" edge="1" source="s2_inprog" target="s2_completed" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t2_4" value="cannot fix&lt;br&gt;(approved)" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;fontSize=9;" edge="1" source="s2_inprog" target="s2_deferred" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t2_5" value="reopen" style="endArrow=block;endFill=1;strokeColor=#999;strokeWidth=1;dashed=1;fontSize=9;" edge="1" source="s2_deferred" target="s2_open" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="170"/></Array></mxGeometry></mxCell>
        <mxCell id="t2_6" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" source="s2_completed" target="s2_end1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

