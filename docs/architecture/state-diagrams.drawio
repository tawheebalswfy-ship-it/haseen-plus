        </mxCell>
        <mxCell id="s2_completed" value="completed" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="360" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s2_deferred" value="deferred" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
