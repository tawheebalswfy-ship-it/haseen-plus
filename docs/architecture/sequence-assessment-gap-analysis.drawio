<mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="Sequence — Assessment &amp; Gap Analysis" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="250" y="10" width="600" height="35" as="geometry"/>
    </mxCell>

    <mxCell id="ll_user" value="User" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;participant=umlActor;fillColor=#DAE8FC;strokeColor=#6C8EBF;size=40;" vertex="1" parent="1">
      <mxGeometry x="60" y="60" width="20" height="610" as="geometry"/>
    </mxCell>
    <mxCell id="ll_assess" value=":AssessmentsPage" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FFF2CC;strokeColor=#D6B656;size=40;" vertex="1" parent="1">
      <mxGeometry x="200" y="60" width="130" height="610" as="geometry"/>
    </mxCell>
    <mxCell id="ll_store" value=":ComplianceStore" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FFE6CC;strokeColor=#D79B00;size=40;" vertex="1" parent="1">
      <mxGeometry x="430" y="60" width="130" height="610" as="geometry"/>
    </mxCell>
    <mxCell id="ll_supabase" value=":Supabase DB" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#E1D5E7;strokeColor=#9673A6;size=40;" vertex="1" parent="1">
      <mxGeometry x="660" y="60" width="100" height="610" as="geometry"/>
    </mxCell>
    <mxCell id="ll_storage" value=":Supabase&#xa;Storage" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#E1D5E7;strokeColor=#9673A6;size=40;" vertex="1" parent="1">
      <mxGeometry x="860" y="60" width="100" height="610" as="geometry"/>
    </mxCell>
    <mxCell id="ll_remed" value=":RemediationPage" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FFE6CC;strokeColor=#D79B00;size=40;" vertex="1" parent="1">
      <mxGeometry x="1050" y="60" width="130" height="610" as="geometry"/>
    </mxCell>

    <!-- 1. Create assessment -->
    <mxCell id="m1" value="1. Click 'New Assessment' (select policy + framework)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="70" y="130" as="sourcePoint"/>
        <mxPoint x="265" y="130" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="m2" value="2. addAssessment({policyId, framework, controls: NCA_CONTROLS})" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="265" y="165" as="sourcePoint"/>
        <mxPoint x="495" y="165" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="m3" value="INSERT assessments" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="495" y="195" as="sourcePoint"/>
        <mxPoint x="710" y="195" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="m3r" value="assessmentId" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="710" y="220" as="sourcePoint"/>
        <mxPoint x="265" y="220" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <!-- Loop: control evaluation -->
    <mxCell id="loop" value="loop [for each control]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=130;height=20;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="250" width="840" height="160" as="geometry"/>
    </mxCell>

    <mxCell id="m4" value="4. Mark control status (compliant / partial / non-compliant)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="70" y="290" as="sourcePoint"/>
        <mxPoint x="265" y="290" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="m5" value="5. Upload evidence file" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="265" y="325" as="sourcePoint"/>
        <mxPoint x="910" y="325" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="m5r" value="file URL" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="910" y="345" as="sourcePoint"/>
        <mxPoint x="265" y="345" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="m6" value="6. Add comment to control" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="70" y="375" as="sourcePoint"/>
        <mxPoint x="265" y="375" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="m6s" value="updateAssessment(id, {controls})" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="265" y="395" as="sourcePoint"/>
        <mxPoint x="495" y="395" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <!-- Calculate score -->
    <mxCell id="m7" value="7. Calculate overall compliance score" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="265" y="440" as="sourcePoint"/>
        <mxPoint x="265" y="460" as="targetPoint"/>
        <Array as="points">
          <mxPoint x="300" y="440"/>
          <mxPoint x="300" y="460"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <mxCell id="m8" value="8. updateAssessment(id, {status: 'completed', overall_score})" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="265" y="490" as="sourcePoint"/>
        <mxPoint x="495" y="490" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="m8s" value="UPDATE assessments" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="495" y="515" as="sourcePoint"/>
        <mxPoint x="710" y="515" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <!-- Generate tasks -->
    <mxCell id="m9" value="9. Generate remediation tasks for non-compliant controls" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="265" y="555" as="sourcePoint"/>
        <mxPoint x="1115" y="555" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="m9s" value="addTask() per gap → Supabase" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1115" y="585" as="sourcePoint"/>
        <mxPoint x="495" y="585" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="m10" value="assessment complete" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="265" y="620" as="sourcePoint"/>
        <mxPoint x="70" y="620" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

  </root>
</mxGraphModel>