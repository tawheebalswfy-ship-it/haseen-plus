# Supabase - get from Supabase Console > Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# FastAPI Gap Detector
# Leave empty in production when Nginx proxies /analyze and /health.
# Set to http://44.223.40.115 for local frontend using the AWS backend.
# Set to http://127.0.0.1:8080 for local frontend using a local backend.
VITE_API_URL=
VITE_API_KEY=your-api-key
