# Neon Auth — get from Neon Console → Auth tab
VITE_NEON_AUTH_URL=https://your-project.neonauth.*.neon.tech/neondb/auth

# Neon Database — get from Neon Console → Connection Details (pooled)
# Optional: if not set, history and user sync features are disabled
VITE_NEON_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Supabase — get from Supabase Console → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# FastAPI Gap Detector — Cloud Run URL
VITE_API_BASE_URL=https://your-cloud-run-url.run.app
VITE_API_KEY=your-api-key
